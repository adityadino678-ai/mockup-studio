{
  "name": "mockup-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
"scripts": {
    "dev": "concurrently -n proxy,app -c yellow,cyan \"npm:dev:proxy\" \"npm:dev:app\"",
    "dev:app": "vite",
    "dev:proxy": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:import && npm run test:storage && npm run test:printify",
    "test:import": "esbuild scripts/import-test.ts --bundle --platform=node --format=cjs --outfile=scripts/.tmp-import.cjs --log-level=warning && node scripts/.tmp-import.cjs",
    "test:storage": "esbuild scripts/storage-test.ts --bundle --platform=node --format=cjs --outfile=scripts/.tmp-storage.cjs --log-level=warning && node scripts/.tmp-storage.cjs",
    "test:printify": "esbuild scripts/printify-test.ts --bundle --platform=node --format=cjs --outfile=scripts/.tmp-printify.cjs --log-level=warning && node scripts/.tmp-printify.cjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
